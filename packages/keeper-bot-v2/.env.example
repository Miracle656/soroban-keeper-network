# Soroban Keeper Network — v2 Configuration Example
#
# Copy this file to .env and fill in your own values.

# Network to connect to: testnet, futurenet, or mainnet
NETWORK=testnet

# Contract ID of the KeeperRegistry on the chosen network
# Must start with C...
REGISTRY_CONTRACT_ID=C...

# ──────────────────────────────────────────────────────────────────────────────
# SIGNING KEYS CONFIGURATION
#
# The keeper bot supports three methods for loading signing keys:
#
# 1. ENVIRONMENT VARIABLE (DEFAULT - Local Development)
#    Simple and convenient for local development, but NOT recommended for
#    production. Keys are visible in process listings and log files.
#
# 2. HASHICORP VAULT (Production)
#    Secure key storage with encryption at rest and automatic rotation support.
#    The bot fetches keys from Vault at startup via authenticated API call.
#
# 3. AWS SECRETS MANAGER (Production AWS)
#    Native AWS secret storage with IAM-based access control, encryption,
#    and CloudTrail auditing.
#
# ──────────────────────────────────────────────────────────────────────────────

# OPTION 1: ENVIRONMENT VARIABLE (Default - Local Dev Only)
# ──────────────────────────────────────────────────────────────────────────────
# For local development, provide signing keys directly as environment variables.
# Single key: KEEPER_SECRET_KEY=S...
# Multiple keys (multi-account): SIGNING_KEY_POOL=S...,S...,S...
#
# NEVER commit actual keys to version control.

KEEPER_SECRET_KEY=S...

# Optional: For multi-account support, comma-separated list of signing keys
# SIGNING_KEY_POOL=S...,S...,S...

# OPTION 2: HASHICORP VAULT (Production)
# ──────────────────────────────────────────────────────────────────────────────
# Uncomment to use Vault backend. When VAULT_ADDR is set, the bot automatically
# switches to Vault mode and fetches keys from there instead of environment variables.
#
# Expected secret format in Vault:
# ```
# {
#   "keys": "S...,S...,S..."
# }
# ```
#
# Setup steps:
# 1. Store your signing keys in Vault at the configured path
# 2. Create a Vault token with read access to that secret
# 3. Set VAULT_ADDR and VAULT_TOKEN in your environment
#
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=s.xxxxxxxxxxxxxxxx
# VAULT_PATH=secret/data/keeper-bot/signing-keys

# OPTION 3: AWS SECRETS MANAGER (Production AWS)
# ──────────────────────────────────────────────────────────────────────────────
# Uncomment to use AWS Secrets Manager backend. When AWS_SECRET_NAME is set,
# the bot automatically switches to AWS mode and fetches keys from there instead
# of environment variables.
#
# Expected secret format in AWS Secrets Manager:
# - Raw string: S... or S...,S...,S...
# - JSON: {"keys": "S...,S...,S..."}
#
# Setup steps:
# 1. Store your signing keys in AWS Secrets Manager
# 2. Ensure your execution role/credentials have SecretManager read permissions
# 3. Set AWS_SECRET_NAME and optionally AWS_REGION
#
# AWS_SECRET_NAME=keeper-bot/signing-keys
# AWS_REGION=us-east-1

# Explicit backend selection (optional)
# When multiple backends could be configured, use this to force a specific one.
# Valid values: env, vault, aws_secrets_manager
# If not set, the bot auto-detects based on other env vars.
# SECRET_MANAGER_BACKEND=env

# ──────────────────────────────────────────────────────────────────────────────
# REST OF CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Optional: polling interval in milliseconds (default: 10000)
POLL_INTERVAL_MS=10000

# Optional: minimum balance (in stroops) to accumulate before withdrawing (default: 10000000)
WITHDRAW_THRESHOLD=10000000

# Optional: maximum tasks to process per round (default: 5)
MAX_TASKS_PER_ROUND=5

# Optional: maximum retry attempts for transient RPC errors (default: 3)
MAX_RETRIES=3

# Optional: base delay (in ms) for exponential backoff retry (default: 500)
RETRY_BASE_MS=500

# Optional: whether to expire stale tasks after their deadline (default: true)
EXPIRE_STALE_TASKS=true

# Optional: minimum profit margin in stroops for claiming a task (default: 0)
# Task is skipped if: reward - estimated_gas_fee - margin < 0
MIN_PROFIT_MARGIN_STROOPS=0

# Optional: path to persistent state database (default: ./keeper-state.db)
# This is where task outcomes and skip decisions are stored
STATE_DB_PATH=./keeper-state.db

# Optional: development only — simulate execution instead of calling actual executors (default: false)
# NEVER enable in production: a keeper that fabricates proofs violates the trust model
SIMULATE_EXECUTION=false

# ──────────────────────────────────────────────────────────────────────────────
# Indexer integration (optional — enables indexer-backed task discovery)
#
# When both INDEXER_WS_URL and INDEXER_REST_URL are set the bot subscribes to
# the indexer WebSocket feed for new TaskRegistered events instead of scanning
# getEvents directly. This removes lookback-window edge cases and reduces RPC
# load across keepers.
#
# The authoritative on-chain is_claimable check is still performed before every
# claim regardless of which source is active (issue #0034). Indexer data is used
# only for candidate discovery — the chain is always the claimability authority.
#
# When either URL is absent the bot falls back to direct RPC event scanning,
# preserving standalone operation without an indexer deployment.
# ──────────────────────────────────────────────────────────────────────────────

# WebSocket endpoint for the indexer's live event feed (must start with ws:// or wss://)
# Example: ws://localhost:8080/v1/ws
# INDEXER_WS_URL=

# REST base URL for the indexer API (must start with http:// or https://)
# Example: http://localhost:8080/v1
# INDEXER_REST_URL=
